---
// Site footer. Adapted from AstroWind: the horizontal logo replaces the site name, and the Typst
// credit is plain text with no Typst logo (brand/README.md).
import Logo from '~/components/Logo.astro';
import { footerLinks } from '~/navigation';
---

<footer class="relative border-t border-base-300">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid grid-cols-12 gap-4 gap-y-8 py-8 sm:gap-8 md:py-12">
      <div class="col-span-12 lg:col-span-6">
        <a class="inline-block p-1.5" href="/" aria-label="Typrest home">
          <Logo />
        </a>
        <p class="mt-3 max-w-sm text-sm text-muted">
          JSON in, PDF out: an HTTP service that renders Typst templates.
        </p>
      </div>
      {
        footerLinks.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3">
            <div class="mb-2 font-medium">{title}</div>
            <ul class="text-sm">
              {links.map(({ text, href }) => (
                <li class="mb-2">
                  <a class="text-muted hover:text-accent hover:underline" href={href}>
                    {text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="flex flex-col gap-2 border-t border-base-300 py-6 text-sm text-muted md:flex-row md:justify-between">
      <span>Typrest is licensed under Apache-2.0.</span>
      <span>
        Built with <a class="prose-link" href="https://typst.app/">Typst</a>. Typrest is not an official Typst
        project.
      </span>
    </div>
  </div>
</footer>
