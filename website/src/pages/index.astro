---
import { Image } from 'astro:assets';
import PageLayout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import QuickStart from '~/components/widgets/QuickStart.astro';
import TypstIntro from '~/components/widgets/TypstIntro.astro';
import Customize from '~/components/widgets/Customize.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import ExampleCard from '~/components/ExampleCard.astro';
import { examples } from '~/lib/examples';
import { RELEASE_ARCHIVE, releaseAsset } from '~/config';
import webuiScreenshot from '~/assets/webui.png';

const HIGHLIGHTED_EXAMPLES = ['invoice', 'certificate', 'report'];
const highlighted = HIGHLIGHTED_EXAMPLES.flatMap((name) => examples.filter((example) => example.name === name));
---

<PageLayout>
  <Hero />

  <Features
    id="features"
    tagline="Why Typrest"
    title="The simple way to produce PDFs from your data"
    subtitle="Every business system ends up needing documents. Typrest gives all of them one small service to ask."
    items={[
      {
        title: 'Documents that look printed',
        description:
          'Real typesetting, with precise pages, tables, fonts, and images. No headless browser, and no fighting HTML and CSS to fit a sheet of paper.',
      },
      {
        title: 'Works with every language',
        description:
          'Typrest speaks plain HTTP. Anything that can send a request can create a PDF: your backend, a script, a low-code tool.',
      },
      {
        title: 'Running in minutes',
        description:
          'One small program, or one Docker image. There is no database to set up, no account to create, and nothing else to install.',
      },
      {
        title: 'Templates are files you own',
        description:
          'Each document is a folder of plain text files. Keep them in git, review changes like code, and reuse one look across all of them.',
      },
      {
        title: 'Mistakes caught early',
        description:
          'A broken template stops the server from starting, not a customer from getting an invoice. Incomplete data is refused with a clear message.',
      },
      {
        title: 'Free, open, and private',
        description:
          'Typrest is open source and runs on your own machines. Your templates and your customers’ data never leave them.',
      },
    ]}
  />

  <TypstIntro id="typst" />

  <QuickStart
    id="quick-start"
    tagline="Quick start"
    title="Your first PDF in three steps"
    subtitle='These commands are for Linux. For Docker, Cargo, and other systems, see <a href="/docs/install/">Install</a>.'
    steps={[
      {
        title: 'Install Typrest',
        description: 'Download the release and put the <code>typrest</code> program on your path.',
        label: 'shell',
        code: `curl -fLO ${releaseAsset(RELEASE_ARCHIVE)}\ntar -xzf ${RELEASE_ARCHIVE}\ninstall -Dm 755 typrest ~/.local/bin/typrest`,
      },
      {
        title: 'Create a project and start the server',
        description: 'The new project comes with a <code>hello-world</code> template, ready to render.',
        label: 'shell',
        code: 'typrest init demo\ncd demo\ntyprest serve',
      },
      {
        title: 'Send JSON, get a PDF',
        description: 'From another terminal:',
        label: 'shell',
        code: `curl -X POST http://127.0.0.1:8080/hello-world \\\n  -H 'Content-Type: application/json' \\\n  --data '{"name":"Ada"}' \\\n  --output hello-world.pdf`,
      },
    ]}
  >
    <p class="mt-10 text-center">
      <a class="btn btn-outline" href="/docs/quick-start/">Read the full quick start</a>
    </p>
  </QuickStart>

  <Customize id="customize" />

  <WidgetWrapper id="examples" paper containerClass="max-w-6xl">
    <Headline
      tagline="Examples"
      title="Real documents, rendered by Typrest"
      subtitle="Every preview below is the first page of a PDF that Typrest rendered from the example's sample payload."
    />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {highlighted.map((example) => <ExampleCard example={example} />)}
    </div>
    <p class="mt-10 text-center">
      <a class="btn btn-outline" href="/examples/">See all {examples.length} examples</a>
    </p>
  </WidgetWrapper>

  <WidgetWrapper id="web-ui" containerClass="max-w-6xl">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <Headline
          tagline="Web UI"
          title="See the document while you write it"
          subtitle="Typrest includes a free page for working on templates. Pick a document, fill in a form built from its fields, and look at the PDF right beside it. It is the quickest way to try an idea or show a draft to a colleague."
          classes={{ container: 'text-left mb-6 md:mb-6' }}
        />
        <a class="btn btn-outline" href="/docs/web-ui/">Learn about the Web UI</a>
      </div>
      <figure class="overflow-hidden rounded-box border border-base-300 bg-base-200">
        <Image
          src={webuiScreenshot}
          alt="The Typrest Web UI with the invoice template's payload form beside its rendered PDF"
          widths={[640, 960, 1440]}
          sizes="(min-width: 1024px) 700px, 100vw"
          class="w-full"
        />
      </figure>
    </div>
  </WidgetWrapper>

  <FAQs
    id="faq"
    tagline="FAQ"
    title="Questions"
    items={[
      {
        title: 'Is Typrest a hosted service?',
        description:
          'No. Typrest is a server you run yourself, next to the applications that need PDFs. Templates live in a project folder on that server.',
      },
      {
        title: 'Do I need to know Rust?',
        description:
          'No. Typrest is written in Rust, but you install it as a ready-made program or a Docker image and never touch the source.',
      },
      {
        title: 'Do I need to know Typst?',
        description:
          'Only to design the documents. Start from one of the <a href="/examples/">examples</a> and change it; the <a href="https://typst.app/docs/tutorial/">Typst tutorial</a> covers the rest. The systems that request PDFs only send JSON.',
      },
      {
        title: 'Which systems does it run on?',
        description:
          'There is a ready-made program for 64-bit Linux, and a Docker image that runs anywhere Docker does, including macOS and Windows. See <a href="/docs/install/">Install</a>.',
      },
      {
        title: 'Is Typrest an official Typst project?',
        description:
          'No. Typrest is an independent project that uses the open-source <a href="https://typst.app/">Typst</a> compiler.',
      },
      {
        title: 'Can I expose it to the internet?',
        description:
          'Not directly. Typrest has no login of its own, so run it where only your own systems can reach it, such as a private network. See <a href="/docs/deploy/">Run in production</a>.',
      },
      {
        title: 'How is it licensed?',
        description: 'Typrest is open source under the Apache License 2.0.',
      },
    ]}
  />

  <CallToAction
    title="Render your first PDF"
    subtitle="Install Typrest, create a project, and send it JSON."
    actions={[
      { text: 'Get started', href: '/docs/quick-start/', primary: true },
      { text: 'Read the docs', href: '/docs/' },
    ]}
  />
</PageLayout>
