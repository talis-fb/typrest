// Cloudflare Workers static assets. The site is fully static: the Worker only serves dist/.
// Deployed by .github/workflows/website-deploy.yml; see docs/development/website.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typrest-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "typrest.talison.dev", "custom_domain": true }],
}
